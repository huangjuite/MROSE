<launch>

    <arg name="seq" default="1692139890_nsh_atrium" />
    <!-- <arg name="seq" default="1692311541_ghc_ramp" /> -->
    <!-- <arg name="seq" default="1692923792_ghc_stair" /> -->

    <!-- <arg name="seq" default="1692312182_nsh_4th" /> -->
    <!-- <arg name="seq" default="1692145970_frc" /> -->
    <!-- <arg name="seq" default="1692308112_frc_2nd" /> -->

    <arg name="data_root" default="/home/rpl/Documents/RPL_radar" />
    <arg name="bag_folder" default="$(arg data_root)/$(arg seq)/rosbag" />
    <!-- <arg name="gt_path" default="$(arg data_root)/$(arg seq)/ground_truth/odom_loam.csv" /> -->
    <arg name="gt_path" default="$(arg data_root)/$(arg seq)/ground_truth/odom_vio.csv" />

    <rosparam file="$(find radar_odom)/cfg/params_razor.yaml" />

    <node name="map_gt" pkg="radar_odom" type="map_gt" output="screen">
        <param name="gt_path" value="$(arg gt_path)" />
        <param name="bag_folder" value="$(arg bag_folder)" />
    </node>

</launch>