<launch>

    <!-- parameter -->
    <!-- <arg name="bag_folder"
    default="/home/rpl/Documents/RPL_radar/nsh4_h_trimed_1687287495/rosbag" /> -->
    <!-- <rosparam file="$(find radar_odom)/cfg/params_old.yaml" /> -->

    <arg name="data_root" default="/home/rpl/Documents/RPL_radar" />
    <!-- <arg name="data_root" default="/media/rpl/teamgroup/RPL_radar" /> -->

    <!-- <arg name="sequence" default="1692139890_nsh_atrium" /> -->
    <!-- <arg name="sequence" default="1692311541_ghc_ramp" /> -->
    <!-- <arg name="sequence" default="1692312182_nsh_4th" /> -->
    <!-- <arg name="sequence" default="1692145970_frc" /> -->
    <!-- <arg name="sequence" default="1692308112_frc_2nd" /> -->
    <arg name="sequence" default="1692923792_ghc_stair" />
    <!-- <arg name="sequence" default="1692923153" /> -->

    <!-- <rosparam file="$(find radar_odom)/cfg/params_epson.yaml" /> -->
    <rosparam file="$(find radar_odom)/cfg/params_razor.yaml" />

    <!-- <arg name="save_log" default="/tmp/odom_rio.csv" /> -->
    <arg name="save_log"
        default="$(arg data_root)/$(arg sequence)/result/odom_rio.csv" />
    <arg name="bag_folder" default="$(arg data_root)/$(arg sequence)/rosbag" />
    <arg name="gt_path" default="$(arg data_root)/$(arg sequence)/ground_truth/odom_vio.csv" />

    <arg name="info_plot" default="false" />

    <!-- noise prediction -->
    <!-- <node name="noise_predict" pkg="radar_odom" type="RadarUncertainty.py" output="screen" /> -->

    <!-- odometry -->
    <node name="doppler_odom_bag" pkg="radar_odom" type="doppler_odom_bag" output="screen">
        <param name="bag_folder" value="$(arg bag_folder)" />
        <param name="save_path" value="$(arg save_log)" />
    </node>

    <node name="pub_gt" pkg="radar_odom" type="publish_gt" output="screen">
        <param name="gt_path" value="$(arg gt_path)" />
    </node>


    <node if="$(arg info_plot)" pkg="plotjuggler" type="plotjuggler" name="plot"
        args="-l $(find radar_odom)/cfg/info_vis.xml" />

    <!-- pose graph -->
    <node name="radar_pose_graph" pkg="radar_odom" type="map_optimize" output="screen" />
    <!-- <node name="radar_pose_graph" pkg="radar_odom" type="map_optimize_weighted" output="screen"
    /> -->

</launch>