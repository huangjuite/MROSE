<launch>

    <arg name="bag_folder" default="/home/rpl/Documents/RPL_radar/frc_h_1687205888/rosbag" />
    <arg name="gt_path"
        default="/home/rpl/Documents/RPL_radar/frc_h_1687205888/odom_vio.csv" />

    <rosparam file="$(find radar_odom)/cfg/params.yaml" />
    
    <node name="noise_predict" pkg="radar_odom" type="RadarUncertainty.py" output="screen" />
    
    <node name="rio_extrinsic" pkg="radar_odom" type="test_noise_prediction" output="screen">
        <param name="bag_folder" value="$(arg bag_folder)" />
        <param name="gt_path" value="$(arg gt_path)" />
    </node>

</launch>