<launch>

    <arg name="bag_folder" default="/home/rpl/Documents/RPL_radar/1687547791_flat/rosbag"/>

    <rosparam file="$(find radar_odom)/cfg/params.yaml" />
    <node name="rio_extrinsic" pkg="radar_odom" type="dio_ex" output="screen">
        <param name="bag_folder" value="$(arg bag_folder)" />
    </node>

</launch>