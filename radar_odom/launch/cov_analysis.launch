<launch>

    <arg name="bag_folder" default="/home/rpl/Documents/RPL_radar/1692139890_nsh_atrium/rosbag" />
    <arg name="gt_path" default="/home/rpl/Documents/RPL_radar/1692139890_nsh_atrium/odom_vio.csv" />

    <rosparam file="$(find radar_odom)/cfg/params.yaml" />
    <node name="cov_analysis" pkg="radar_odom" type="covariance_analysis" output="screen">
        <param name="bag_folder" value="$(arg bag_folder)" />
        <param name="gt_path" value="$(arg gt_path)" />
    </node>
    
</launch>