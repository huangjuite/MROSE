<launch>

    <!-- odometry parameter -->
    <rosparam file="$(find radar_odom)/cfg/params.yaml" />
    <arg name="info_plot" default="false" />

    <!-- loop close parameter -->
    <arg name="enable_loop_close" default="true" />
    <arg name="loop_close_rate" default="40" />             <!-- frames-->
    <arg name="loop_ignore" default="100" />                <!-- frames-->
    <arg name="key_frame_search" default="30" />            <!-- frames-->
    <arg name="loop_distance_thresh" default="2" />         <!-- meter-->
    <arg name="process_voxel_size" default="0.2" />         <!-- meter-->
    <arg name="ndt_voxel_size" default="0.5" />             <!-- meter-->
    <arg name="max_range" default="15" />                    <!-- meter-->
    <arg name="snr_thresh" default="1.6" />                   <!-- log dB-->

    <!-- mapping parameter -->
    <arg name="map_voxel_process" default="0.2" />          <!-- meter-->
    <arg name="map_reconfigure" default="false" />
    <arg name="map_snr_thresh" default="1" />               <!-- log dB-->

    <!-- odometry -->
    <node name="doppler_odom" pkg="radar_odom" type="doppler_odom" output="screen" />
    <node if="$(arg info_plot)" pkg="plotjuggler" type="plotjuggler" name="plot"
        args="-l $(find radar_odom)/cfg/info_vis.xml" />

    <!-- pose graph -->
    <node name="radar_pose_graph" pkg="radar_odom" type="radar_pose_graph" output="screen">
        <param name="enable_loop_close" value="$(arg enable_loop_close)" />
        <param name="loop_close_rate" value="$(arg loop_close_rate)" />
        <param name="loop_ignore" value="$(arg loop_ignore)" />
        <param name="key_frame_search" value="$(arg key_frame_search)" />
        <param name="loop_distance_thresh" value="$(arg loop_distance_thresh)" />
        <param name="process_voxel_size" value="$(arg process_voxel_size)" />
        <param name="ndt_voxel_size" value="$(arg ndt_voxel_size)" />
        <param name="snr_thresh" value="$(arg snr_thresh)" />
    </node>

    <!-- mapping -->
    <node name="radar_mapping" pkg="radar_odom" type="radar_mapping" output="screen">
        <param name="process_voxel_size" value="$(arg map_voxel_process)" />
        <param name="snr_thresh" value="$(arg map_snr_thresh)" />
    </node>

    <!-- <node if="$(arg map_reconfigure)" pkg="rqt_reconfigure" type="rqt_reconfigure"
        name="reconfigure" />
    <node pkg="dynamic_reconfigure" type="dynparam" name="load_mapping_param"
        args="load /radar_mapping $(find radar_odom)/cfg/map_config.yaml" /> -->

</launch>